          "width": 87,
          "height": 53,
          "customInputs": [],
          "customOutputs": [],
          "milliseconds": "8"
        },
        {
          "objID": "ed5d5ac7-dcd6-4f07-99f9-f1d2abcefbbe",
          "type": "SetVariableActionComponent",
          "left": 534,
          "top": 512,
          "width": 735,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "entries": [
            {
              "objID": "3bfbb0f1-eb8c-4ffb-e639-6c1a7c2a89e3",
              "variable": "vario",
              "value": "Math.sin(Date.now() / 3200) * 2.5 + Math.sin(Date.now() / 1600) * 1.2 + Math.sin(Date.now() / 500) * 0.4"
            }
          ]
        },
        {
          "objID": "2e1ce6a5-533f-46fb-cc51-85e1be1676d0",
          "type": "LoopActionComponent",
          "left": 637,
          "top": 675,
          "width": 260,
          "height": 71,
          "customInputs": [],
          "customOutputs": [],
          "variable": "i",
          "from": "0",
          "to": "1000000000",
          "step": "1",
          "version": 1
        },
        {
          "objID": "thermal-avg-sv-comp-0001",
          "type": "SetVariableActionComponent",
          "left": 534,
          "top": 575,
          "width": 348,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "entries": [
            {
              "objID": "thermal-avg-entry-id-001",
              "variable": "thermal_avg",
              "value": "thermal_avg * 0.999 + vario * 0.001"
            }
          ]
        },
        {
          "objID": "display-vario-sv-comp-001",
          "type": "SetVariableActionComponent",
          "left": 534,
          "top": 640,
          "width": 361,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "entries": [
            {
              "objID": "display-vario-entry-001",
              "variable": "display_vario",
              "value": "display_vario * 0.92 + vario * 0.08"
            }
